
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Strike Zone FPS</title>
<style>
body {
    margin: 0;
    overflow: hidden;
    background: #111;
    color: white;
    font-family: Arial, sans-serif;
}
canvas { display: block; }
#hud {
    position: fixed;
    top: 15px;
    left: 15px;
    z-index: 2;
    line-height: 1.8;
    text-shadow: 1px 1px 3px black;
}
#crosshair {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%,-50%);
    font-size: 25px;
    pointer-events: none;
}
#menu {
    position: fixed;
    inset: 0;
    background: #111e;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    z-index: 5;
}
button {
    padding: 12px 20px;
    margin: 5px;
    cursor: pointer;
    background: #263b49;
    color: white;
    border: 1px solid #789;
    border-radius: 5px;
}
#shop {
    display: none;
    position: fixed;
    top: 25%;
    left: 50%;
    transform: translateX(-50%);
    background: #17232d;
    padding: 20px;
    z-index: 4;
}
</style>
</head>
<body>

<div id="menu">
    <h1>STRIKE ZONE</h1>
    <p>WASD: Move | Mouse: Aim | Click: Shoot</p>
    <p>E: Plant/Defuse | B: Buy | R: Reload</p>
    <button onclick="startGame('T')">Play Terrorist</button>
    <button onclick="startGame('CT')">Play Counter-Terrorist</button>
</div>

<div id="hud">
    <div>Team: <span id="team">-</span></div>
    <div>Health: <span id="health">100</span></div>
    <div>Money: $<span id="money">800</span></div>
    <div>Weapon: <span id="weapon">Pistol</span></div>
    <div>Ammo: <span id="ammo">12 / 48</span></div>
    <div>Round: <span id="round">1</span></div>
    <div id="objective">Waiting to deploy</div>
</div>

<div id="crosshair">+</div>

<div id="shop">
    <h2>Weapon Shop</h2>
    <div id="shopItems"></div>
    <button onclick="closeShop()">Close Shop</button>
</div>

<script type="module">
import * as THREE from
'https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js';

const scene = new THREE.Scene();
scene.background = new THREE.Color(0x8799a3);

const camera = new THREE.PerspectiveCamera(
    75, innerWidth / innerHeight, 0.1, 1000
);

const renderer = new THREE.WebGLRenderer({ antialias: true });
renderer.setSize(innerWidth, innerHeight);
renderer.shadowMap.enabled = true;
document.body.appendChild(renderer.domElement);

scene.add(new THREE.HemisphereLight(0xffffff, 0x444444, 2));

const light = new THREE.DirectionalLight(0xffffff, 2);
light.position.set(10, 20, 10);
scene.add(light);

const material = color =>
    new THREE.MeshStandardMaterial({ color });

const floor = new THREE.Mesh(
    new THREE.PlaneGeometry(50, 50),
    material(0x555b5d)
);
floor.rotation.x = -Math.PI / 2;
scene.add(floor);

const obstacles = [];

function makeBox(x, y, z, sx, sy, sz, color) {
    const mesh = new THREE.Mesh(
        new THREE.BoxGeometry(sx, sy, sz),
        material(color)
    );

    mesh.position.set(x, y, z);
    mesh.castShadow = true;
    mesh.receiveShadow = true;
    scene.add(mesh);

    obstacles.push({
        x, z, hx: sx / 2, hz: sz / 2
    });

    return mesh;
}

// Map walls and cover
makeBox(0, 1.5, -15, 30, 3, 1, 0x626b70);
makeBox(0, 1.5, 15, 30, 3, 1, 0x626b70);
makeBox(-15, 1.5, 0, 1, 3, 30, 0x626b70);
makeBox(15, 1.5, 0, 1, 3, 30, 0x626b70);

makeBox(-5, 1, 0, 3, 2, 3, 0x927d60);
makeBox(5, 1, -4, 3, 2, 3, 0x927d60);
makeBox(2, 1, 5, 4, 2, 2, 0x737b7e);

// Bomb sites
const sites = [
    { x: -10, z: -10, name: 'A' },
    { x: 10, z: 10, name: 'B' }
];

for (const site of sites) {
    const marker = new THREE.Mesh(
        new THREE.CylinderGeometry(2, 2, 0.08, 24),
        new THREE.MeshBasicMaterial({
            color: 0xffaa22,
            transparent: true,
            opacity: 0.5
        })
    );

    marker.position.set(site.x, 0.05, site.z);
    scene.add(marker);
}

const weapons = {
    Pistol: {
        cost: 0, damage: 34, head: 100,
        mag: 12, reserve: 48, rate: 300, range: 40
    },
    SMG: {
        cost: 1500, damage: 23, head: 100,
        mag: 25, reserve: 100, rate: 100, range: 35
    },
    Rifle: {
        cost: 2700, damage: 31, head: 100,
        mag: 30, reserve: 90, rate: 120, range: 70
    },
    Sniper: {
        cost: 4750, damage: 85, head: 100,
        mag: 5, reserve: 20, rate: 900, range: 100
    }
};

let currentWeapon = 'Pistol';
let ammo = {};
let money = 800;
let health = 100;
let team = 'T';
let round = 1;
let phase = 'buy';
let timeLeft = 15;
let planted = false;
let bombTime = 40;
let hasBomb = true;
let alive = true;
let gameStarted = false;
let lastShot = 0;
let reloading = false;
let defuseTime = 0;
let pointerLocked = false;
let yaw = 0;
let pitch = 0;

for (const name in weapons) {
    ammo[name] = {
        mag: weapons[name].mag,
        reserve: weapons[name].reserve
    };
}

const player = new THREE.Vector3(0, 1.7, 10);
const bots = [];
const keys = {};
const raycaster = new THREE.Raycaster();

function makeBot(botTeam, x, z) {
    const group = new THREE.Group();

    const body = new THREE.Mesh(
        new THREE.CylinderGeometry(0.4, 0.4, 1.2, 10),
        material(botTeam === team ? 0x268bd2 : 0xc0392b)
    );
    body.position.y = 0.85;
    group.add(body);

    const head = new THREE.Mesh(
        new THREE.SphereGeometry(0.28, 12, 12),
        material(0xd6ad8b)
    );
    head.position.y = 1.65;
    group.add(head);

    group.position.set(x, 0, z);
    scene.add(group);

    return {
        group, body, head,
        team: botTeam,
        hp: 100,
        alive: true,
        nextShot: 0
    };
}

function spawnBots() {
    for (const bot of bots) scene.remove(bot.group);
    bots.length = 0;

    for (let i = 0; i < 5; i++) {
        const enemyTeam = team === 'T' ? 'CT' : 'T';
        bots.push(makeBot(
            enemyTeam,
            (Math.random() - 0.5) * 20,
            (Math.random() - 0.5) * 20
        ));
    }
}

function startGame(selectedTeam) {
    team = selectedTeam;
    health = 100;
    money = 800;
    round = 1;
    planted = false;
    hasBomb = team === 'T';
    phase = 'buy';
    timeLeft = 15;
    alive = true;
    gameStarted = true;

    player.set(
        team === 'T' ? -11 : 11,
        1.7,
        team === 'T' ? 10 : -10
    );

    yaw = team === 'T' ? Math.PI : 0;
    pitch = 0;

    spawnBots();

    document.getElementById('menu').style.display = 'none';
    renderer.domElement.requestPointerLock();
    updateHUD();
}

document.addEventListener('pointerlockchange', () => {
    pointerLocked =
        document.pointerLockElement === renderer.domElement;
});

document.addEventListener('mousemove', e => {
    if (!pointerLocked) return;

    yaw -= e.movementX * 0.002;
    pitch -= e.movementY * 0.002;
    pitch = Math.max(-1.4, Math.min(1.4, pitch));
});

document.addEventListener('keydown', e => {
    keys[e.code] = true;

    if (e.code === 'KeyB') openShop();
    if (e.code === 'KeyR') reload();
    if (e.code === 'KeyE') interact();
    if (e.code === 'Digit1') switchWeapon('Pistol');
    if (e.code === 'Digit2') switchWeapon('Rifle');
    if (e.code === 'Digit3') switchWeapon('Sniper');
});

document.addEventListener('keyup', e => {
    keys[e.code] = false;
});

document.addEventListener('mousedown', e => {
    if (e.button === 0 && gameStarted) {
        if (!pointerLocked) {
            renderer.domElement.requestPointerLock();
        } else {
            shoot();
        }
    }
});

function switchWeapon(name) {
    if (weapons[name]) currentWeapon = name;
    updateHUD();
}

function openShop() {
    if (phase !== 'buy') return;

    const shop = document.getElementById('shop');
    shop.style.display = 'block';

    const list = document.getElementById('shopItems');
    list.innerHTML = '';

    for (const name in weapons) {
        const w = weapons[name];
        const button = document.createElement('button');

        button.textContent = `${name} — $${w.cost}`;
        button.disabled = money < w.cost;

        button.onclick = () => {
            if (money < w.cost) return;

            money -= w.cost;
            currentWeapon = name;
            ammo[name] = {
                mag: w.mag,
                reserve: w.reserve
            };

            updateHUD();
            openShop();
        };

        list.appendChild(button);
    }
}

function closeShop() {
    document.getElementById('shop').style.display = 'none';
}

function reload() {
    const w = weapons[currentWeapon];
    const a = ammo[currentWeapon];

    if (reloading || a.mag === w.mag || a.reserve <= 0) return;

    reloading = true;

    setTimeout(() => {
        const amount = Math.min(w.mag - a.mag, a.reserve);
        a.mag += amount;
        a.reserve -= amount;
        reloading = false;
        updateHUD();
    }, 1000);
}

function shoot() {
    const now = performance.now();
    const w = weapons[currentWeapon];
    const a = ammo[currentWeapon];

    if (!alive || phase === 'buy' || reloading) return;
    if (now - lastShot < w.rate) return;

    if (a.mag <= 0) {
        reload();
        return;
    }

    lastShot = now;
    a.mag--;

    const direction = new THREE.Vector3(
        Math.sin(yaw) * Math.cos(pitch),
        Math.sin(pitch),
        -Math.cos(yaw) * Math.cos(pitch)
    );

    raycaster.set(player, direction);
    raycaster.far = w.range;

    const targets = [];

    for (const bot of bots) {
        if (!bot.alive || bot.team === team) continue;

        for (const part of [bot.head, bot.body]) {
            const hit = raycaster.intersectObject(part)[0];

            if (hit) {
                targets.push({
                    distance: hit.distance,
                    bot,
                    headshot: part === bot.head
                });
            }
        }
    }

    targets.sort((a, b) => a.distance - b.distance);

    if (targets.length) {
        const hit = targets[0];
        hit.bot.hp -= hit.headshot ? w.head : w.damage;

        if (hit.bot.hp <= 0) {
            hit.bot.alive = false;
            scene.remove(hit.bot.group);
            money += 300;
            checkWin();
        }
    }

    updateHUD();
}

function interact() {
    if (!alive) return;

    if (team === 'T' && hasBomb && !planted && phase === 'live') {
        const site = sites.find(s =>
            Math.hypot(player.x - s.x, player.z - s.z) < 2.5
        );

        if (site) {
            planted = true;
            hasBomb = false;
            phase = 'bomb';
            bombTime = 40;
            document.getElementById('objective').textContent =
                'Bomb planted at Site ' + site.name;
        }
    } else if (
        team === 'CT' && planted &&
        Math.hypot(
            player.x - sites.find(s =>
                Math.hypot(player.x-s.x, player.z-s.z) < 3
            )?.x || 100,
            player.z - (sites.find(s =>
                Math.hypot(player.x-s.x, player.z-s.z) < 3
            )?.z || 100)
        ) < 3
    ) {
        defuseTime += 1;

        if (defuseTime >= 4) endRound('Bomb defused!', 'CT');
    }
}

function checkWin() {
    if (bots.every(b => !b.alive || b.team === team)) {
        endRound('All enemies eliminated!', team);
    }
}

function endRound(message, winner) {
    if (phase === 'ended') return;

    phase = 'ended';
    document.getElementById('objective').textContent = message;

    money += winner === team ? 3250 : 1400;

    setTimeout(() => {
        round++;
        health = 100;
        alive = true;
        planted = false;
        hasBomb = team === 'T';
        phase = 'buy';
        timeLeft = 15;
        defuseTime = 0;

        player.set(
            team === 'T' ? -11 : 11,
            1.7,
            team === 'T' ? 10 : -10
        );

        spawnBots();
        updateHUD();
    }, 3000);
}

function updateHUD() {
    document.getElementById('team').textContent = team;
    document.getElementById('health').textContent = health;
    document.getElementById('money').textContent = money;
    document.getElementById('weapon').textContent = currentWeapon;
    document.getElementById('ammo').textContent =
        `${ammo[currentWeapon].mag} / ${ammo[currentWeapon].reserve}`;
    document.getElementById('round').textContent = round;

    if (phase === 'buy') {
        document.getElementById('objective').textContent =
            'Buy phase: ' + Math.ceil(timeLeft) + 's';
    } else if (phase === 'live') {
        document.getElementById('objective').textContent =
            'Round in progress: ' + Math.ceil(timeLeft) + 's';
    } else if (phase === 'bomb') {
        document.getElementById('objective').textContent =
            'BOMB PLANTED: ' + Math.ceil(bombTime) + 's';
    }
}

function movePlayer(dt) {
    if (!pointerLocked || !alive) return;

    const forward = new THREE.Vector3(
        Math.sin(yaw), 0, -Math.cos(yaw)
    );
    const right = new THREE.Vector3(
        forward.z, 0, -forward.x
    );

    let dx = 0, dz = 0;

    if (keys.KeyW) { dx += forward.x; dz += forward.z; }
    if (keys.KeyS) { dx -= forward.x; dz -= forward.z; }
    if (keys.KeyA) { dx -= right.x; dz -= right.z; }
    if (keys.KeyD) { dx += right.x; dz += right.z; }

    const length = Math.hypot(dx, dz) || 1;
    const speed = keys.ShiftLeft ? 7 : 4.5;

    dx = dx / length * speed * dt;
    dz = dz / length * speed * dt;

    const radius = 0.4;

    const blocked = (x, z) => obstacles.some(o =>
        Math.abs(x - o.x) < o.hx + radius &&
        Math.abs(z - o.z) < o.hz + radius
    );

    if (!blocked(player.x + dx, player.z)) player.x += dx;
    if (!blocked(player.x, player.z + dz)) player.z += dz;

    player.x = Math.max(-14, Math.min(14, player.x));
    player.z = Math.max(-14, Math.min(14, player.z));
}

function updateBots(dt) {
    for (const bot of bots) {
        if (!bot.alive) continue;

        const p = bot.group.position;
        const dx = player.x - p.x;
        const dz = player.z - p.z;
        const distance = Math.hypot(dx, dz);

        if (distance > 5) {
            p.x += dx / distance * 2 * dt;
            p.z += dz / distance * 2 * dt;
        }

        bot.group.rotation.y = Math.atan2(dx, dz);

        if (distance < 18 && performance.now() > bot.nextShot) {
            bot.nextShot = performance.now() + 900;

            if (Math.random() < 0.25) {
                health -= 10;

                if (health <= 0) {
                    health = 0;
                    alive = false;
                    endRound('You were eliminated!', 'CT');
                }
            }
        }
    }
}

let previous = performance.now();

function animate(now) {
    requestAnimationFrame(animate);

    const dt = Math.min((now - previous) / 1000, 0.05);
    previous = now;

    if (gameStarted && phase !== 'ended') {
        if (phase === 'buy') {
            timeLeft -= dt;

            if (timeLeft <= 0) {
                phase = 'live';
                timeLeft = 100;
            }
        } else if (phase === 'live') {
            timeLeft -= dt;

            if (timeLeft <= 0) {
                endRound('Time expired!', team === 'CT' ? 'CT' : 'T');
            }
        } else if (phase === 'bomb') {
            bombTime -= dt;

            if (bombTime <= 0) endRound('Bomb exploded!', 'T');

            if (team === 'CT' && keys.KeyE && planted) {
                defuseTime += dt;

                if (defuseTime >= 4) endRound('Bomb defused!', 'CT');
            } else {
                defuseTime = 0;
            }
        }

        movePlayer(dt);
        updateBots(dt);

        camera.position.copy(player);
        camera.rotation.order = 'YXZ';
        camera.rotation.y = yaw;
        camera.rotation.x = pitch;

        updateHUD();
    }

    renderer.render(scene, camera);
}

addEventListener('resize', () => {
    camera.aspect = innerWidth / innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(innerWidth, innerHeight);
});

updateHUD();
animate(performance.now());
</script>
</body>
</html>
